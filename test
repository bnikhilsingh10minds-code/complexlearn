import Test from "../models/Test.js";
import Result from "../models/Result.js";
import User from "../models/User.js";
import Reward from "../models/Reward.js";
import { calculateScore } from "../utils/calculateScore.js";

export async function createTest(req, res, next) {
  try {
    const { title, subject, className, durationMinutes = 30, questions = [] } = req.body;
    if (!title || !subject || !className || !Array.isArray(questions) || questions.length === 0) {
      return res.status(400).json({ message: "Title, subject, class, and questions are required" });
    }
    for (const q of questions) {
      if (!q.prompt || !Array.isArray(q.options) || q.options.length < 2 ||
          !Number.isInteger(q.correctAnswer) || q.correctAnswer < 0 || q.correctAnswer >= q.options.length) {
        return res.status(400).json({ message: "Each question needs a prompt, options, and valid correctAnswer index" });
      }
    }
    const test = await Test.create({
      title, subject, className, durationMinutes, questions,
      createdBy: req.user._id, published: false
    });
    res.status(201).json({ test });
  } catch (err) { next(err); }
}

export async function publishTest(req, res, next) {
  try {
    const test = await Test.findOne({ _id: req.params.id, createdBy: req.user._id });
    if (!test) return res.status(404).json({ message: "Test not found" });
    test.published = true;
    await test.save();
    res.json({ message: "Test published", test });
  } catch (err) { next(err); }
}

export async function listPublishedTests(req, res, next) {
  try {
    const filter = { published: true };
    if (req.user.role === "student") filter.className = req.user.className;
    const tests = await Test.find(filter).select("title subject className durationMinutes questions createdAt");
    const safeTests = tests.map(t => ({
      ...t.toObject(),
      questions: t.questions.map(q => ({ _id: q._id, prompt: q.prompt, options: q.options, marks: q.marks }))
    }));
    res.json({ tests: safeTests });
  } catch (err) { next(err); }
}

export async function submitTest(req, res, next) {
  try {
    const test = await Test.findOne({ _id: req.params.id, published: true });
    if (!test) return res.status(404).json({ message: "Published test not found" });
    if (req.user.role !== "student" || test.className !== req.user.className) {
      return res.status(403).json({ message: "This test is not available for your class" });
    }

    const answers = Array.isArray(req.body.answers) ? req.body.answers : [];
    const seen = new Set();
    for (const a of answers) {
      if (!Number.isInteger(a.questionIndex) || !Number.isInteger(a.selectedOption) ||
          a.questionIndex < 0 || a.questionIndex >= test.questions.length ||
          a.selectedOption < 0 || a.selectedOption >= test.questions[a.questionIndex].options.length ||
          seen.has(a.questionIndex)) {
        return res.status(400).json({ message: "Invalid or duplicate answer" });
      }
      seen.add(a.questionIndex);
    }

    const existing = await Result.findOne({ student: req.user._id, test: test._id });
    if (existing) return res.status(409).json({ message: "You have already submitted this test" });

    const { score, totalMarks } = calculateScore(test, answers);
    const result = await Result.create({ student: req.user._id, test: test._id, answers, score, totalMarks });

    // Demo reward rule: award 5 coins for a score of at least 80%.
    if (totalMarks > 0 && score / totalMarks >= 0.8) {
      await User.updateOne({ _id: req.user._id }, { $inc: { coins: 5 } });
      await Reward.create({ student: req.user._id, description: `Reward for ${test.title}`, coins: 5, source: "test" });
    }

    res.status(201).json({ result: { id: result._id, score, totalMarks, percentage: totalMarks ? Math.round(score / totalMarks * 100) : 0 } });
  } catch (err) { next(err); }
}

export async function listResults(req, res, next) {
  try {
    const filter = req.user.role === "student" ? { student: req.user._id } : {};
    const results = await Result.find(filter).populate("student", "name email className").populate("test", "title subject");
    res.json({ results });
  } catch (err) { next(err); }
}