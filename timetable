import Timetable from "../models/Timetable.js";

export async function listTimetable(req, res, next) {
  try {
    const entries = await Timetable.find({ student: req.user._id }).sort({ startAt: 1 });
    res.json({ entries });
  } catch (err) { next(err); }
}

export async function createTimetable(req, res, next) {
  try {
    const { subject, title, startAt, endAt } = req.body;
    if (!subject || !title || !startAt || !endAt || new Date(endAt) <= new Date(startAt)) {
      return res.status(400).json({ message: "Valid subject, title, startAt, and endAt are required" });
    }
    const entry = await Timetable.create({ student: req.user._id, subject, title, startAt, endAt });
    res.status(201).json({ entry });
  } catch (err) { next(err); }
}